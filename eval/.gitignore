# bulky / regenerable eval artifacts — keep scripts, manifests, results CSVs, REPORT
inputs/
detail/
detail-*/
bin/
*.in
_smoke*.csv
_e0smoke*.csv
__pycache__/
# trace artifacts if any land here
dependency_*/
*_eval_cubins/
# but DO keep the manifests (document what was run; root .gitignore ignores *.json)
!manifests/
!manifests/*.json

# third-party tool checkouts/artifacts (large; SuperCollider runtime .so is proprietary)
baselines/setup/tools/
# baselines bulk data: corpora checkouts (nested git repos), kept traces, per-run confirm JSON, tool setups
baselines/corpora/
baselines/traces_keep*/
baselines/confirm*/
baselines/bin/
baselines/inputs/
baselines/setup/hirace/
baselines/setup/iguard/
baselines/setup/build_logs/
baselines/setup/.job_*
baselines/setup/smoke_*/

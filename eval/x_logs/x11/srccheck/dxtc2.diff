-// Round Up Division function
-size_t shrRoundUp(int group_size, int global_size) 
-{
-    int r = global_size % group_size;
-    if(r == 0) 
-    {
-        return global_size;
-    } else 
-    {
-        return global_size + group_size - r;
-    }
-}

-    }
-
-    if (channels == 1)
-    {
-        fh << "P5\n";
-    }
-    else if (channels == 3) {
-        fh << "P6\n";
-    }
-    else {
-        std::cerr << "savePPM() : Invalid number of channels." << std::endl;
-        return shrFALSE;
-    }
-
-    fh << w << "\n" << h << "\n" << 0xff << std::endl;
-
-    for( unsigned int i = 0; (i < (w*h*channels)) && fh.good(); ++i) 

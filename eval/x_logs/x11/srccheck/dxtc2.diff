-shrBOOL savePPM( const char* file, unsigned char *data, 
-             unsigned int w, unsigned int h, unsigned int channels) 
-{
-    ARGCHECK(NULL != data);
-    ARGCHECK(w > 0);
-    ARGCHECK(h > 0);
-
-    std::fstream fh( file, std::fstream::out | std::fstream::binary );
